  updatedAt   DateTime       @updatedAt @map("updated_at")
  book        PaddyKhataBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([workspace, bookId, variety, status])
  @@map("paddy_khata_processes")
}

model PaddyKhataExpense {
