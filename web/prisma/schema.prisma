generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SUPERVISOR
  OPERATOR
  VIEWER
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum SellingStatus {
  PENDING
  IN_QUEUE
  SELLING
  SOLD
  CANCELLED
}

enum QueueStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentType {
  FARMER
  BUYER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SaleSourceType {
  FARMER
  BUSINESS_STOCK
}

enum StockTransactionType {
  INCOMING
  OUTGOING
  TRANSFER
  ADJUSTMENT
  SALE
}

model User {
  id                  BigInt           @id @default(autoincrement())
  username            String           @unique @db.VarChar(100)
  email               String           @unique @db.VarChar(255)
  password            String           @db.VarChar(255)
  fullName            String           @map("full_name") @db.VarChar(255)
  role                UserRole         @default(OPERATOR)
  workspace           String           @default("live") @db.VarChar(20)
  themePreference     ThemePreference  @default(SYSTEM) @map("theme_preference")
  active              Boolean          @default(true)
  deleted             Boolean          @default(false)
  failedLoginAttempts Int              @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?        @map("locked_until")
  lastLoginAt         DateTime?        @map("last_login_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  auditLogs           AuditLog[]
  stockTransactions   StockTransaction[]
  sales               Sale[]
  payments            Payment[]
  loginSessions       LoginSession[]

  @@map("users")
}

/// Tracks each login so owners can see how often/how long staff use the site
// Multiple concurrent sessions per user are required — owner and staff are shared shop logins.
model LoginSession {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  loginAt     DateTime  @default(now()) @map("login_at")
  logoutAt    DateTime? @map("logout_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  durationSec Int?      @map("duration_sec")
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  workspace   String    @default("live") @db.VarChar(20)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, loginAt])
  @@index([active, lastSeenAt])
  @@map("login_sessions")
}

model BusinessSettings {
  id                           BigInt   @id @default(autoincrement())
  workspace                    String   @unique @default("live") @db.VarChar(20)
  companyName                  String   @default("Rehmani Trading Company") @map("company_name") @db.VarChar(255)
  companyLogoUrl               String?  @map("company_logo_url") @db.VarChar(500)
  address                      String?
  phone                        String?  @db.VarChar(50)
  email                        String?  @db.VarChar(255)
  defaultCommissionPercentage  Decimal  @default(4.00) @map("default_commission_percentage") @db.Decimal(5, 2)
  supervisorSharePercentage    Decimal  @default(0.70) @map("supervisor_share_percentage") @db.Decimal(5, 2)
  laborSharePercentage         Decimal  @default(0.30) @map("labor_share_percentage") @db.Decimal(5, 2)
  arhatSharePercentage         Decimal  @default(3.00) @map("arhat_share_percentage") @db.Decimal(5, 2)
  lowStockThreshold            Decimal  @default(100.00) @map("low_stock_threshold") @db.Decimal(12, 2)
  backupReminderDays           Int      @default(7) @map("backup_reminder_days")
  paymentReminderDays          Int      @default(3) @map("payment_reminder_days")
  geminiApiKey                 String?  @map("gemini_api_key") @db.VarChar(255)
  weatherLatitude              Decimal  @default(31.520400) @map("weather_latitude") @db.Decimal(10, 6)
  weatherLongitude             Decimal  @default(74.358700) @map("weather_longitude") @db.Decimal(10, 6)
  weatherLocationLabel         String   @default("Lahore") @map("weather_location_label") @db.VarChar(120)
  weatherTimezone              String   @default("Asia/Karachi") @map("weather_timezone") @db.VarChar(64)
  hijriAdjustmentDays          Int      @default(0) @map("hijri_adjustment_days")
  stockZeroedAt                DateTime? @map("stock_zeroed_at")
  paddyExtraIdsPrunedAt        DateTime? @map("paddy_extra_ids_pruned_at")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}

model Product {
  id               BigInt   @id @default(autoincrement())
  workspace        String   @default("live") @db.VarChar(20)
  productCode      String   @map("product_code") @db.VarChar(50)
  name             String   @db.VarChar(255)
  unit             String   @default("BAG") @db.VarChar(50)
  defaultBagWeight Decimal  @default(40.00) @map("default_bag_weight") @db.Decimal(10, 2)
  description      String?
  active           Boolean  @default(true)
  deleted          Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  stock            Stock?
  dheris           Dheri[]
  saleItems        SaleItem[]
  stockTransactions StockTransaction[]
  stockLots        StockLot[]
  dailyTradeSessions DailyTradeSession[]

  @@unique([workspace, productCode])
  @@index([workspace])
  @@map("products")
}

model Farmer {
  id                 BigInt   @id @default(autoincrement())
  workspace          String   @default("live") @db.VarChar(20)
  farmerId           String   @map("farmer_id") @db.VarChar(20)
  name               String   @db.VarChar(255)
  fatherName         String?  @map("father_name") @db.VarChar(255)
  cnic               String?  @db.VarChar(20)
  phone              String?  @db.VarChar(20)
  address            String?
  city               String?  @db.VarChar(100)
  outstandingBalance Decimal  @default(0.00) @map("outstanding_balance") @db.Decimal(15, 2)
  notes              String?
  active             Boolean  @default(true)
  deleted            Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  trucks             Truck[]
  dheris             Dheri[]
  payments           Payment[]
  saleItems          SaleItem[]
  stockLots          StockLot[]
  registerEntries    RegisterEntry[]

  @@unique([workspace, farmerId])
  @@index([workspace])
  @@index([workspace, deleted])
  @@map("farmers")
}

model Buyer {
  id                 BigInt   @id @default(autoincrement())
  workspace          String   @default("live") @db.VarChar(20)
  buyerId            String   @map("buyer_id") @db.VarChar(20)
  name               String   @db.VarChar(255)
  fatherName         String?  @map("father_name") @db.VarChar(255)
  cnic               String?  @db.VarChar(20)
  phone              String?  @db.VarChar(20)
  address            String?
  city               String?  @db.VarChar(100)
  outstandingBalance Decimal  @default(0.00) @map("outstanding_balance") @db.Decimal(15, 2)
  notes              String?
  active             Boolean  @default(true)
  deleted            Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  sales              Sale[]
  payments           Payment[]

  @@unique([workspace, buyerId])
  @@index([workspace])
  @@index([workspace, deleted])
  @@map("buyers")
}

model Truck {
  id                 BigInt   @id @default(autoincrement())
  workspace          String   @default("live") @db.VarChar(20)
  truckId            String   @map("truck_id") @db.VarChar(20)
  registrationNumber String   @map("registration_number") @db.VarChar(50)
  driverName         String?  @map("driver_name") @db.VarChar(255)
  driverPhone        String?  @map("driver_phone") @db.VarChar(20)
  farmerId           BigInt   @map("farmer_id")
  capacity           Decimal? @db.Decimal(10, 2)
  notes              String?
  active             Boolean  @default(true)
  deleted            Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  farmer             Farmer   @relation(fields: [farmerId], references: [id])
  dheris             Dheri[]

  @@unique([workspace, truckId])
  @@index([workspace])
  @@map("trucks")
}

model Dheri {
  id                   BigInt        @id @default(autoincrement())
  workspace            String        @default("live") @db.VarChar(20)
  dheriId              String        @map("dheri_id") @db.VarChar(20)
  farmerId             BigInt        @map("farmer_id")
  truckId              BigInt?       @map("truck_id")
  productId            BigInt        @map("product_id")
  queueNumber          Int?          @map("queue_number")
  numberOfBags         Int           @default(0) @map("number_of_bags")
  weightPerBag         Decimal       @default(40.00) @map("weight_per_bag") @db.Decimal(10, 2)
  partialBagWeight     Decimal       @default(0.00) @map("partial_bag_weight") @db.Decimal(10, 2)
  totalWeight          Decimal       @default(0.00) @map("total_weight") @db.Decimal(12, 2)
  marketRate           Decimal       @default(0.00) @map("market_rate") @db.Decimal(12, 2)
  commissionPercentage Decimal       @default(4.00) @map("commission_percentage") @db.Decimal(5, 2)
  totalPrice           Decimal       @default(0.00) @map("total_price") @db.Decimal(15, 2)
  commissionAmount     Decimal       @default(0.00) @map("commission_amount") @db.Decimal(15, 2)
  farmerReceivable     Decimal       @default(0.00) @map("farmer_receivable") @db.Decimal(15, 2)
  supervisorShare      Decimal       @default(0.00) @map("supervisor_share") @db.Decimal(15, 2)
  laborShare           Decimal       @default(0.00) @map("labor_share") @db.Decimal(15, 2)
  arhatShare           Decimal       @default(0.00) @map("arhat_share") @db.Decimal(15, 2)
  sellingStatus        SellingStatus @default(PENDING) @map("selling_status")
  payablePosted        Boolean       @default(false) @map("payable_posted")
  dayBatchId           BigInt?       @map("day_batch_id")
  notes                String?
  deleted              Boolean       @default(false)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  farmer               Farmer        @relation(fields: [farmerId], references: [id])
  truck                Truck?        @relation(fields: [truckId], references: [id])
  product              Product       @relation(fields: [productId], references: [id])
  dayBatch             DayBatch?     @relation(fields: [dayBatchId], references: [id])
  queueEntry           QueueEntry?
  saleItems            SaleItem[]
  payments             Payment[]
  stockLots            StockLot[]

  @@unique([workspace, dheriId])
  @@index([workspace])
  @@index([workspace, dayBatchId])
  @@index([workspace, farmerId, deleted])
  @@map("dheris")
}

model Stock {
  id            BigInt   @id @default(autoincrement())
  workspace     String   @default("live") @db.VarChar(20)
  productId     BigInt   @unique @map("product_id")
  quantity      Decimal  @default(0.00) @db.Decimal(15, 2)
  lowStockAlert Boolean  @default(false) @map("low_stock_alert")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  product       Product  @relation(fields: [productId], references: [id])

  @@index([workspace])
  @@map("stock")
}

model StockTransaction {
  id               BigInt               @id @default(autoincrement())
  workspace        String               @default("live") @db.VarChar(20)
  productId        BigInt               @map("product_id")
  transactionType  StockTransactionType @map("transaction_type")
  quantity         Decimal              @db.Decimal(15, 2)
  previousQuantity Decimal              @map("previous_quantity") @db.Decimal(15, 2)
  newQuantity      Decimal              @map("new_quantity") @db.Decimal(15, 2)
  referenceType    String?              @map("reference_type") @db.VarChar(50)
  referenceId      BigInt?              @map("reference_id")
  farmerId         BigInt?              @map("farmer_id")
  dheriId          BigInt?              @map("dheri_id")
  ratePer40Kg      Decimal?             @map("rate_per_40kg") @db.Decimal(12, 2)
  amountValue      Decimal?             @map("amount_value") @db.Decimal(15, 2)
  notes            String?
  createdById      BigInt?              @map("created_by")
  createdAt        DateTime             @default(now()) @map("created_at")
  product          Product              @relation(fields: [productId], references: [id])
  createdBy        User?                @relation(fields: [createdById], references: [id])

  @@index([workspace])
  @@map("stock_transactions")
}

model QueueEntry {
  id          BigInt      @id @default(autoincrement())
  workspace   String      @default("live") @db.VarChar(20)
  queueNumber Int         @map("queue_number")
  dheriId     BigInt      @unique @map("dheri_id")
  status      QueueStatus @default(PENDING)
  position    Int
  startedAt   DateTime?   @map("started_at")
  completedAt DateTime?   @map("completed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  dheri       Dheri       @relation(fields: [dheriId], references: [id])

  @@index([workspace])
  @@map("queue_entries")
}

model Sale {
  id            BigInt        @id @default(autoincrement())
  workspace     String        @default("live") @db.VarChar(20)
  invoiceNumber String        @map("invoice_number") @db.VarChar(30)
  buyerId       BigInt        @map("buyer_id")
  saleDate      DateTime      @map("sale_date") @db.Date
  totalBags     Int           @default(0) @map("total_bags")
  totalWeight   Decimal       @default(0.00) @map("total_weight") @db.Decimal(15, 2)
  totalAmount   Decimal       @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  paidAmount    Decimal       @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  notes         String?
  deleted       Boolean       @default(false)
  createdById   BigInt?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  buyer         Buyer         @relation(fields: [buyerId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id])
  items         SaleItem[]
  payments      Payment[]

  @@unique([workspace, invoiceNumber])
  @@index([workspace])
  @@index([workspace, deleted, saleDate])
  @@index([workspace, buyerId, deleted])
  @@map("sales")
}

model SaleItem {
  id               BigInt         @id @default(autoincrement())
  workspace        String         @default("live") @db.VarChar(20)
  saleId           BigInt         @map("sale_id")
  productId        BigInt         @map("product_id")
  sourceType       SaleSourceType @map("source_type")
  farmerId         BigInt?        @map("farmer_id")
  dheriId          BigInt?        @map("dheri_id")
  numberOfBags     Int            @default(0) @map("number_of_bags")
  weightPerBag     Decimal        @default(40.00) @map("weight_per_bag") @db.Decimal(10, 2)
  partialBagWeight Decimal        @default(0.00) @map("partial_bag_weight") @db.Decimal(10, 2)
  totalWeight      Decimal        @default(0.00) @map("total_weight") @db.Decimal(12, 2)
  rate             Decimal        @default(0.00) @db.Decimal(12, 2)
  amount           Decimal        @default(0.00) @db.Decimal(15, 2)
  sale             Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])
  farmer           Farmer?        @relation(fields: [farmerId], references: [id])
  dheri            Dheri?         @relation(fields: [dheriId], references: [id])

  @@index([workspace])
  @@map("sale_items")
}

model Payment {
  id              BigInt                 @id @default(autoincrement())
  workspace       String                 @default("live") @db.VarChar(20)
  paymentType     PaymentType            @map("payment_type")
  farmerId        BigInt?                @map("farmer_id")
  buyerId         BigInt?                @map("buyer_id")
  saleId          BigInt?                @map("sale_id")
  dheriId         BigInt?                @map("dheri_id")
  amount          Decimal                @db.Decimal(15, 2)
  paymentMethod   PaymentMethod          @default(CASH) @map("payment_method")
  paymentDate     DateTime               @map("payment_date") @db.Date
  referenceNumber String?                @map("reference_number") @db.VarChar(100)
  notes           String?
  status          PaymentApprovalStatus  @default(APPROVED)
  createdById     BigInt?                @map("created_by")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  farmer          Farmer?                @relation(fields: [farmerId], references: [id])
  buyer           Buyer?                 @relation(fields: [buyerId], references: [id])
  sale            Sale?                  @relation(fields: [saleId], references: [id])
  dheri           Dheri?                 @relation(fields: [dheriId], references: [id])
  createdBy       User?                  @relation(fields: [createdById], references: [id])

  @@index([workspace])
  @@index([workspace, farmerId])
  @@index([workspace, buyerId])
  @@index([workspace, paymentType, createdAt])
  @@map("payments")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  workspace  String   @default("live") @db.VarChar(20)
  userId     BigInt?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   BigInt?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([workspace])
  @@map("audit_logs")
}

model SyncState {
  id        Int      @id
  workspace String   @unique @default("live") @db.VarChar(20)
  revision  BigInt   @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

enum DailyTradeStatus {
  OPEN
  ARCHIVED
}

enum DayBatchStatus {
  RECEIVING
  SELLING
  CLOSED
}

/// Extra KG held as stock with farmer/rate provenance for batch selling
model StockLot {
  id            BigInt   @id @default(autoincrement())
  workspace     String   @default("live") @db.VarChar(20)
  productId     BigInt   @map("product_id")
  farmerId      BigInt?  @map("farmer_id")
  dheriId       BigInt?  @map("dheri_id")
  remainingKg   Decimal  @map("remaining_kg") @db.Decimal(15, 2)
  originalKg    Decimal  @map("original_kg") @db.Decimal(15, 2)
  ratePer40Kg   Decimal  @map("rate_per_40kg") @db.Decimal(12, 2)
  bagWeightKg   Decimal  @default(40.00) @map("bag_weight_kg") @db.Decimal(10, 2)
  amountValue   Decimal  @default(0.00) @map("amount_value") @db.Decimal(15, 2)
  intakeDate    DateTime @map("intake_date") @db.Date
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  product       Product  @relation(fields: [productId], references: [id])
  farmer        Farmer?  @relation(fields: [farmerId], references: [id])
  dheri         Dheri?   @relation(fields: [dheriId], references: [id])

  @@index([workspace, productId])
  @@index([workspace, intakeDate])
  @@map("stock_lots")
}

/// One receiving/selling group within a calendar day (Batch 1, Batch 2, …)
model DayBatch {
  id          BigInt         @id @default(autoincrement())
  workspace   String         @default("live") @db.VarChar(20)
  batchDate   DateTime       @map("batch_date") @db.Date
  batchNumber Int            @map("batch_number")
  status      DayBatchStatus @default(RECEIVING)
  notes       String?
  closedAt    DateTime?      @map("closed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  dheris      Dheri[]

  @@unique([workspace, batchDate, batchNumber])
  @@index([workspace, batchDate, status])
  @@map("day_batches")
}

/// Open daily receiving/selling board; archived on Refresh into history snapshot
model DailyTradeSession {
  id                BigInt           @id @default(autoincrement())
  workspace         String           @default("live") @db.VarChar(20)
  sessionDate       DateTime         @map("session_date") @db.Date
  status            DailyTradeStatus @default(OPEN)
  productId         BigInt?          @map("product_id")
  receivedBags      Int              @default(0) @map("received_bags")
  receivedWeightKg  Decimal          @default(0.00) @map("received_weight_kg") @db.Decimal(15, 2)
  soldBags          Int              @default(0) @map("sold_bags")
  soldWeightKg      Decimal          @default(0.00) @map("sold_weight_kg") @db.Decimal(15, 2)
  stockInKg         Decimal          @default(0.00) @map("stock_in_kg") @db.Decimal(15, 2)
  stockOutKg        Decimal          @default(0.00) @map("stock_out_kg") @db.Decimal(15, 2)
  highestRate       Decimal          @default(0.00) @map("highest_rate") @db.Decimal(12, 2)
  detailsJson       Json?            @map("details_json")
  closedAt          DateTime?        @map("closed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  product           Product?         @relation(fields: [productId], references: [id])

  @@index([workspace, status])
  @@index([workspace, sessionDate])
  @@map("daily_trade_sessions")
}

/// Cash-book person for Arhat Register giving / receiving
model RegisterParty {
  id        BigInt           @id @default(autoincrement())
  workspace String           @default("live") @db.VarChar(20)
  kind      String           @db.VarChar(20)
  name      String           @db.VarChar(255)
  address   String?
  notes     String?
  deleted   Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  entries   RegisterEntry[]

  @@index([workspace, kind])
  @@map("register_parties")
}

/// Giving, receiving, zakat, or farmer-advance ledger line
model RegisterEntry {
  id        BigInt         @id @default(autoincrement())
  workspace String         @default("live") @db.VarChar(20)
  kind      String         @db.VarChar(20)
  partyId   BigInt?        @map("party_id")
  farmerId  BigInt?        @map("farmer_id")
  paymentId BigInt?        @map("payment_id")
  amount    Decimal        @db.Decimal(15, 2)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  party     RegisterParty? @relation(fields: [partyId], references: [id])
  farmer    Farmer?        @relation(fields: [farmerId], references: [id])

  @@index([workspace, kind, createdAt])
  @@index([workspace, partyId, kind])
  @@map("register_entries")
}

/// Named grain book: a user's Wheat/Barley/Maize/Others khata with a secret code
model GrainKhataBook {
  id          BigInt   @id @default(autoincrement())
  workspace   String   @default("live") @db.VarChar(20)
  key         String   @db.VarChar(80)
  publicId    String?  @map("public_id") @db.VarChar(40)
  name        String   @db.VarChar(255)
  crop        String   @db.VarChar(40)
  secretHash  String?  @map("secret_hash") @db.VarChar(255)
  createdById BigInt?  @map("created_by_id")
  builtin     Boolean  @default(false)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspace, key])
  @@unique([workspace, publicId])
  @@index([workspace, deleted])
  @@index([workspace, createdById, crop])
  @@map("grain_khata_books")
}

/// Bank deposits and borrowed transfers between khata heads
model KhataTreasury {
  id              BigInt   @id @default(autoincrement())
  workspace       String   @default("live") @db.VarChar(20)
  bookType        String   @map("book_type") @db.VarChar(20)
  bookRef         String   @map("book_ref") @db.VarChar(80)
  kind            String   @db.VarChar(20)
  amount          Decimal  @db.Decimal(15, 2)
  bankName        String?  @map("bank_name") @db.VarChar(255)
  counterBookType String?  @map("counter_book_type") @db.VarChar(20)
  counterBookRef  String?  @map("counter_book_ref") @db.VarChar(80)
  counterName     String?  @map("counter_name") @db.VarChar(255)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([workspace, bookType, bookRef, createdAt])
  @@index([workspace, kind, createdAt])
  @@map("khata_treasury")
}

/// Cash deposited into a grain khata (Add Money)
model WheatKhataMoney {
  id        BigInt   @id @default(autoincrement())
  workspace String   @default("live") @db.VarChar(20)
  bookKey   String   @default("WHEAT") @map("book_key") @db.VarChar(80)
  amount    Decimal  @db.Decimal(15, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspace, createdAt])
  @@index([workspace, bookKey, createdAt])
  @@map("wheat_khata_money")
}

/// Receiving party (owner buys) or selling/giving party (owner sells) in one grain book
model WheatKhataParty {
  id        BigInt              @id @default(autoincrement())
  workspace String              @default("live") @db.VarChar(20)
  bookKey   String              @default("WHEAT") @map("book_key") @db.VarChar(80)
  kind      String              @db.VarChar(20)
  name      String              @db.VarChar(255)
  address   String?
  notes     String?
  deleted   Boolean             @default(false)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  products  WheatKhataProduct[]
  payments  WheatKhataPayment[]

  @@index([workspace, kind])
  @@index([workspace, name])
  @@index([workspace, bookKey, kind])
  @@index([workspace, bookKey, deleted])
  @@map("wheat_khata_parties")
}

/// Wheat bags received from or given to a Wheat Khata party
model WheatKhataProduct {
  id             BigInt          @id @default(autoincrement())
  workspace      String          @default("live") @db.VarChar(20)
  partyId        BigInt          @map("party_id")
  bags           Int
  trucks         Int             @default(0)
  bagWeightKg    Decimal         @default(40.00) @map("bag_weight_kg") @db.Decimal(10, 2)
  ratePerBag     Decimal         @map("rate_per_bag") @db.Decimal(12, 2)
  bagPricePerBag Decimal         @default(0.00) @map("bag_price_per_bag") @db.Decimal(12, 2)
  labourPerBag   Decimal         @default(0.00) @map("labour_per_bag") @db.Decimal(12, 2)
  totalPrice     Decimal         @map("total_price") @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  party          WheatKhataParty @relation(fields: [partyId], references: [id])

  @@index([workspace, partyId, createdAt])
  @@map("wheat_khata_products")
}

/// Cash given to a receiving party, or cash received from a selling party
model WheatKhataPayment {
  id        BigInt          @id @default(autoincrement())
  workspace String          @default("live") @db.VarChar(20)
  partyId   BigInt          @map("party_id")
  amount    Decimal         @db.Decimal(15, 2)
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  party     WheatKhataParty @relation(fields: [partyId], references: [id])

  @@index([workspace, partyId, createdAt])
  @@map("wheat_khata_payments")
}

/// Manual cash added, received, or given in Arhat Amount (auto farmer/buyer/register stay in their tables)
model ArhatAmountEntry {
  id        BigInt   @id @default(autoincrement())
  workspace String   @default("live") @db.VarChar(20)
  kind      String   @db.VarChar(20)
  amount    Decimal  @db.Decimal(15, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspace, kind, createdAt])
  @@map("arhat_amount_entries")
}

model PaddyKhataBook {
  id          BigInt   @id @default(autoincrement())
  workspace   String   @default("live") @db.VarChar(20)
  publicId    String   @map("public_id") @db.VarChar(40)
  name        String   @db.VarChar(255)
  secretHash  String   @map("secret_hash") @db.VarChar(255)
  createdById BigInt   @map("created_by_id")
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  amounts     PaddyKhataAmount[]
  parties     PaddyKhataParty[]
  purchases   PaddyKhataPurchase[]
  processes   PaddyKhataProcess[]
  expenses    PaddyKhataExpense[]
  riceLots    PaddyKhataRice[]
  sales       PaddyKhataSale[]
  payments    PaddyKhataCash[]

  @@unique([workspace, publicId])
  @@index([workspace, createdById])
  @@map("paddy_khata_books")
}

model PaddyKhataAmount {
  id        BigInt         @id @default(autoincrement())
  workspace String         @default("live") @db.VarChar(20)
  bookId    BigInt         @map("book_id")
  amount    Decimal        @db.Decimal(15, 2)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  book      PaddyKhataBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([workspace, bookId, createdAt])
  @@map("paddy_khata_amounts")
}

model PaddyKhataParty {
  id        BigInt               @id @default(autoincrement())
  workspace String               @default("live") @db.VarChar(20)
  bookId    BigInt               @map("book_id")
  kind      String               @db.VarChar(20)
  name      String               @db.VarChar(255)
  address   String?
  notes     String?
  deleted   Boolean              @default(false)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  book      PaddyKhataBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  purchases PaddyKhataPurchase[]
  sales     PaddyKhataSale[]
  payments  PaddyKhataCash[]

  @@index([workspace, bookId, kind])
  @@map("paddy_khata_parties")
}

model PaddyKhataPurchase {
  id            BigInt          @id @default(autoincrement())
  workspace     String          @default("live") @db.VarChar(20)
  bookId        BigInt          @map("book_id")
  partyId       BigInt          @map("party_id")
  bags          Int
  bagWeightKg   Decimal         @default(40.00) @map("bag_weight_kg") @db.Decimal(10, 2)
  extraWeightKg Decimal         @default(0.00) @map("extra_weight_kg") @db.Decimal(10, 2)
  ratePer40Kg   Decimal         @map("rate_per_40_kg") @db.Decimal(12, 2)
  variety       String          @db.VarChar(120)
  bagPrice      Decimal         @default(0.00) @map("bag_price") @db.Decimal(12, 2)
  labourPrice   Decimal         @default(0.00) @map("labour_price") @db.Decimal(12, 2)
  grainAmount   Decimal         @map("grain_amount") @db.Decimal(15, 2)
  bagAmount     Decimal         @default(0.00) @map("bag_amount") @db.Decimal(15, 2)
  labourAmount  Decimal         @default(0.00) @map("labour_amount") @db.Decimal(15, 2)
  totalPrice    Decimal         @map("total_price") @db.Decimal(15, 2)
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  book          PaddyKhataBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  party         PaddyKhataParty @relation(fields: [partyId], references: [id])

  @@index([workspace, bookId, createdAt])
  @@map("paddy_khata_purchases")
}

model PaddyKhataProcess {
  id          BigInt         @id @default(autoincrement())
  workspace   String         @default("live") @db.VarChar(20)
  bookId      BigInt         @map("book_id")
  variety     String         @db.VarChar(120)
  riceVariety String         @default("") @map("rice_variety") @db.VarChar(120)
  partyName   String         @map("party_name") @db.VarChar(255)
